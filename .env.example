# Copy to .env and fill in. Sandbox/test credentials only — never commit real keys.
# SCREAMING_SNAKE_CASE, no spaces around `=`.

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Storage -----------------------------------------------------------------
# Orders and carts live here. Without it the app falls back to in-memory
# storage, which loses every order on restart — fine locally, never in production.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DB=fish_chips_order

# --- Stripe (card) -----------------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` or the webhook endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Revenue Monster (DuitNow / Touch 'n Go / GrabPay / Boost / ShopeePay) ----
# Sandbox credentials from https://sb-manager.revenuemonster.my
REVENUE_MONSTER_API_KEY=xxx
REVENUE_MONSTER_CLIENT_ID=xxx
REVENUE_MONSTER_CLIENT_SECRET=xxx
REVENUE_MONSTER_WEBHOOK_SECRET=xxx
REVENUE_MONSTER_STORE_ID=xxx
REVENUE_MONSTER_API_BASE=https://sb-open.revenuemonster.my

# RM issues this PEM key for request signing. Signing switches on when set.
REVENUE_MONSTER_PRIVATE_KEY_PATH=./secrets/revenue-monster-private.pem
